#!/usr/bin/env bash

# Scan the exact contents about to be committed, not the working tree. This
# intentionally uses unverified detector results too: a possible credential
# should block a commit for review rather than be silently ignored because its
# verification endpoint is unavailable.
set -euo pipefail

npm run lint

if ! command -v trufflehog >/dev/null 2>&1; then
  echo "pre-commit: trufflehog is required but was not found on PATH." >&2
  exit 1
fi

if ! {
  while IFS= read -r -d '' path; do
    # Include the path as inert scan input so a finding can still be traced to
    # its staged source without constructing a temporary working tree.
    printf '\n--- staged file: %s ---\n' "$path"
    git show ":${path}"
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
} | trufflehog stdin --fail --no-update --no-verification --no-color; then
  echo "pre-commit: TruffleHog found a possible secret in staged content." >&2
  exit 1
fi
