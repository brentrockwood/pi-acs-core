{
  "name": "@brentrockwood/pi-acs-core",
  "version": "0.1.0-alpha.1",
  "description": "Experimental Agent Control Standard v0.1 adapter for the Pi coding agent",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brentrockwood/pi-acs-core.git"
  },
  "homepage": "https://github.com/brentrockwood/pi-acs-core#readme",
  "bugs": "https://github.com/brentrockwood/pi-acs-core/issues",
  "files": [
    "src",
    "vendor",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:guardian": "tsx examples/guardian-demo.ts",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3 <0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "26.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-canonicalize": "2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
